# ==============================================================================
# Northwind AP Agent - Environment Variables Template
# Copy this file to .env and fill in credentials. Never commit .env to source control.
# ==============================================================================

# Database (Postgres / Neon / Supabase)
DATABASE_URL=postgresql://northwind:northwind_pass@localhost:5432/northwind_ap
POSTGRES_USER=northwind
POSTGRES_PASSWORD=northwind_pass
POSTGRES_DB=northwind_ap
POSTGRES_PORT=5432

# Storage (Local Directory or Google Cloud Storage Bucket)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
GCS_BUCKET_NAME=northwind-ap-invoices-dev

# Google ADK / Gemini API
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_REGION=us-central1

# Services Endpoints
INTAKE_SERVICE_PORT=8001
EXTRACTION_SERVICE_PORT=8002
MATCHING_SERVICE_PORT=8003
AGENT_SERVICE_PORT=8004
MOCK_ERP_PORT=8010
MOCK_ERP_BASE_URL=http://localhost:8010

# Hardened Safety Policy Configuration
MAX_AUTO_APPROVE_DOLLARS=2500.00
MIN_CONFIDENCE_AUTO_APPROVE=0.85
ALLOW_AUTO_APPROVE_DUPLICATES=false

# Web UI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
